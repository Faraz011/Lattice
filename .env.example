# Copy to .env and fill in. Every Lattice role and docker compose read these.

# Required
LATTICE_NEO4J_URI=bolt://localhost:7687
LATTICE_NEO4J_USER=neo4j
LATTICE_NEO4J_PASSWORD=lattice-dev-password
LATTICE_REDIS_URL=redis://localhost:6379/0
# Shared secret a human types into the UI to approve tier 2-3 actions.
LATTICE_APPROVER_TOKEN=change-me

# Optional (defaults shown)
LATTICE_MCP_URL=http://localhost:8000/mcp
LATTICE_MODEL=google:gemini-flash-latest
LATTICE_GEMINI_API_KEY=
# Optional: per-role models, e.g. {"verifier": "anthropic:claude-sonnet-5-5"}
LATTICE_ROLE_MODELS={}
LATTICE_ANTHROPIC_API_KEY=
LATTICE_LLM_REQUESTS_PER_MINUTE=10
LATTICE_LLM_REQUESTS_PER_DAY=1500
LATTICE_LLM_WAIT_TIMEOUT_S=90
LATTICE_LLM_CACHE_ENABLED=true
LATTICE_LLM_CACHE_TTL_S=604800
LATTICE_REDIS_NAMESPACE=lattice
LATTICE_JOB_IDLE_TIMEOUT_S=30
LATTICE_JOB_HEARTBEAT_S=10
LATTICE_JOB_MAX_ATTEMPTS=3
LATTICE_INVESTIGATION_STEP_BUDGET=12
LATTICE_RISK_THRESHOLD=0.6
